# Reference only: NOT automatically loaded, even when renamed to .env.
# Set process environment in the backend PowerShell BEFORE starting Python.
TRAVEL_MODE=demo
# Independent adapters exist; live itinerary Agent is NOT implemented.
# Never put real keys in this example, frontend variables, code or chat.
DASHSCOPE_API_KEY=
# Beijing standard endpoint below; use your console's matching workspace URL.
# Workspace variant: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn
TRIP_TIMEOUT_SECONDS=120
LLM_TIMEOUT_SECONDS=45
SEARCH_TIMEOUT_SECONDS=10
MAX_MODEL_CALLS=5
MAX_SEARCH_CALLS=6
MAX_MODEL_HTTP_ATTEMPTS=6
MAX_SEARCH_HTTP_ATTEMPTS=8
MAX_UPSTREAM_RETRIES=1
